{
  "name": "yesnai-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yesnai-studio",
      // 主 Cloudflare 账号自建库
      "database_id": "9a313cca-5c61-409f-b8b5-a502acc1cbc3",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "YESNAI_BASE": "https://nai.rinko.ai"
    // 启用出口节点池（按账号固定出口 IP，见 pool/README.md）：部署节点后取消注释。
    // "YESNAI_BASES": "https://节点A.deno.dev,https://节点B.vercel.app"
    // 池密钥不入此文件：npx wrangler secret put UPSTREAM_POOL_KEY
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "yesnai-gallery"
    }
  ]
}
