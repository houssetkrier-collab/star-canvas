{
  "name": "yesnai-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yesnai-studio",
      // 主 Cloudflare 账号自建库
      "database_id": "9a313cca-5c61-409f-b8b5-a502acc1cbc3",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "YESNAI_BASE": "https://nai.rinko.ai"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "yesnai-gallery"
    }
  ]
}
